<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>YUAN PAY BF</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>YUAN PAY BF</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Utilisee pour joindre une preuve de paiement (photo) a un transfert.</string>
	<key>NSCameraUsageDescription</key>
	<string>Utilisee pour prendre un selfie souvenir apres un transfert termine, ajoute a votre livre memoire (stocke uniquement sur cet appareil).</string>
	<!--
	  Connexion "Continuer avec Google" (google_sign_in) : DESACTIVEE cote Dart
	  (voir AppConfig.googleSignInAvailable, false suite a des ANR observes en
	  test, sans rapport avec la config elle-meme). GIDClientID/CFBundleURLTypes
	  retires ici volontairement : des valeurs CHANGE_ME faisaient echouer la
	  validation App Store Connect ("URL schemes ... not in the correct
	  format") a l'upload, meme avec le bouton deja masque dans l'app. A
	  reintroduire avec de vraies valeurs Google Cloud Console (type "iOS",
	  Client ID ecrit a l'envers pour CFBundleURLSchemes) le jour ou
	  googleSignInAvailable repasse a true.
	-->
	<!--
	  Autorise le HTTP en clair (App Transport Security) vers le backend
	  Hetzner de test uniquement, en attendant que Caddy termine le TLS
	  devant (voir Caddyfile.example a la racine du depot). A retirer une
	  fois AppConfig.apiBaseUrl (dev) reponde en HTTPS via un vrai domaine.
	  Flutter ne separe pas ce plist par configuration (Debug/Release) :
	  cette exception est donc active dans tous les builds tant qu'elle
	  reste ici, contrairement au network_security_config.xml Android
	  (limite au dossier src/debug/).
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>178.105.95.145</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<false/>
			</dict>
		</dict>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
