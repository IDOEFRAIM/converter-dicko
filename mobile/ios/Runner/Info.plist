<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>YUAN PAY BF</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>YUAN PAY BF</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Utilisee pour joindre une preuve de paiement (photo) a un transfert.</string>
	<key>NSCameraUsageDescription</key>
	<string>Utilisee pour prendre un selfie souvenir apres un transfert termine, ajoute a votre livre memoire (stocke uniquement sur cet appareil).</string>
	<!--
	  Connexion "Continuer avec Google" (google_sign_in) : CHANGE_ME sur les
	  deux lignes ci-dessous avant tout build iOS reel. Aucune verification
	  possible dans cet environnement (ni Xcode ni Mac) : valeurs
	  volontairement invalides pour ne jamais construire silencieusement avec
	  un Client ID errone.

	  1. GIDClientID : le Client ID OAuth de type "iOS" (PAS le Client ID Web
	     utilise cote backend/GOOGLE_SERVER_CLIENT_ID) : Google Cloud Console >
	     API et services > Identifiants > Creer des identifiants > ID client
	     OAuth > type "iOS", avec le Bundle ID de ce projet.
	  2. CFBundleURLSchemes : l'ID client iOS ecrit a l'ENVERS (ex. Client ID
	     "1234-abcd.apps.googleusercontent.com" -> schema
	     "com.googleusercontent.apps.1234-abcd") : c'est ainsi que Google
	     redirige vers l'app apres le choix du compte.
	-->
	<key>GIDClientID</key>
	<string>CHANGE_ME.apps.googleusercontent.com</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.CHANGE_ME</string>
			</array>
		</dict>
	</array>
	<!--
	  Autorise le HTTP en clair (App Transport Security) vers le backend
	  Hetzner de test uniquement, en attendant que Caddy termine le TLS
	  devant (voir Caddyfile.example a la racine du depot). A retirer une
	  fois AppConfig.apiBaseUrl (dev) reponde en HTTPS via un vrai domaine.
	  Flutter ne separe pas ce plist par configuration (Debug/Release) :
	  cette exception est donc active dans tous les builds tant qu'elle
	  reste ici, contrairement au network_security_config.xml Android
	  (limite au dossier src/debug/).
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>178.105.95.145</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<false/>
			</dict>
		</dict>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
