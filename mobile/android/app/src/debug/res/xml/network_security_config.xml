<?xml version="1.0" encoding="utf-8"?>
<!--
    DEBUG UNIQUEMENT (dossier src/debug/, jamais merge dans un build release) :
    autorise le HTTP en clair vers le backend local (Docker, sans certificat)
    via l'alias emulateur Android 10.0.2.2 -> localhost de la machine hote.
    Voir AppConfig.apiBaseUrl (DEV = dart-define API_BASE_URL=http://10.0.2.2:8080).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>
