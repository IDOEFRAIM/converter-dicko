# =====================================================================
#  Converter — modèle de configuration
#  Copier en `.env` puis renseigner. `.env` est ignoré par Git.
#
#    cp .env.example .env
#
#  AUCUNE valeur de ce fichier n'est un secret réel : ce sont des
#  emplacements à remplir. Ne jamais committer un `.env` renseigné.
# =====================================================================

# ---------------------------------------------------------------------
# Profil applicatif : dev | prod
# ---------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# ---------------------------------------------------------------------
# Base de données PostgreSQL
# ---------------------------------------------------------------------
POSTGRES_DB=converter
POSTGRES_USER=converter
# OBLIGATOIRE en prod. En dev, docker-compose retombe sur une valeur locale.
POSTGRES_PASSWORD=

# URL utilisée par le backend. En local hors Docker :
#   jdbc:postgresql://localhost:5432/converter
# Depuis un conteneur backend dans le compose :
#   jdbc:postgresql://postgres:5432/converter
DB_URL=jdbc:postgresql://localhost:5432/converter
DB_USERNAME=converter
DB_PASSWORD=

# ---------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------
# OBLIGATOIRE en profil `prod` : l'application REFUSE de démarrer sans.
# Minimum 32 octets. Générer avec :
#   openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=120

# ---------------------------------------------------------------------
# Connexion Google (mobile) — FACULTATIF
# ---------------------------------------------------------------------
# Sans valeur, POST /api/auth/google[/complete] répond 503 (fonctionnalité
# désactivée proprement) au lieu d'empêcher le backend de démarrer.
# Client ID Web OAuth 2.0 — Google Cloud Console > API et services >
# Identifiants > Créer des identifiants > ID client OAuth > type "Web
# application". C'est aussi le "Server Client ID" à renseigner côté mobile
# (voir mobile/DEPLOY ou AppConfig) : même Client ID des deux côtés.
GOOGLE_OAUTH_CLIENT_ID=

# ---------------------------------------------------------------------
# CORS — origines autorisées du frontend (séparées par des virgules)
# 4200 = `ng serve` par défaut ; 4300 = port utilisé par .claude/launch.json
# et docker-compose.yml. En production : le(s) domaine(s) réel(s) du frontend.
# ---------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4300

# ---------------------------------------------------------------------
# Amorçage du compte administrateur
# ---------------------------------------------------------------------
# Le seed ne s'exécute que si AUCUN administrateur n'existe déjà.
ADMIN_SEED_ENABLED=true
ADMIN_PHONE=+22500000000
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator
# En profil `dev`, laisser vide => un mot de passe aléatoire est généré
# et affiché UNE SEULE FOIS dans les logs de démarrage.
# En profil `prod`, ce champ est OBLIGATOIRE si le seed est activé.
ADMIN_PASSWORD=

# ---------------------------------------------------------------------
# Serveur
# ---------------------------------------------------------------------
# Port hote de l'API backend.
SERVER_PORT=8080

# Port hote du frontend (nginx). En production derriere un reverse proxy
# TLS, garder 4300 et faire pointer le proxy dessus ; ou mettre 80 pour
# exposer directement.
FRONTEND_PORT=4300
